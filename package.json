{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "patches:import": "node scripts/build-patch-history.mjs --strict",
        "patches:import:check": "node scripts/build-patch-history.mjs --strict --dry-run",
        "patches:sync-feed": "python scripts/sync-patch-feed.py",
        "patches:validate": "python scripts/validate-patch-history.py",
