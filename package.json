        "test:patch-tools": "python -m unittest discover -s tests -p test_*.py"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.21",
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "daisyui": "^5.0.43",
        "laravel-vite-plugin": "^1.2.0",
        "postcss": "^8.5.4",
        "tailwind-scrollbar": "^4.0.2",
        "tailwindcss": "^4.1.8",
        "vite": "^6.0.11"
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.1.8",
        "@tailwindcss/vite": "^4.1.8",
        "alpinejs": "^3.14.9"
    }
}
